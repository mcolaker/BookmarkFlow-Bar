# Public repository allowlist. Generated browser profiles and release archives
# stay outside Git even when new files are added to those directories.
/*

!/.gitignore
!/.gitattributes
!/.github/
!/.github/**
!/AGENTS.md
!/_locales/
!/_locales/**
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/DCO
!/GOVERNANCE.md
!/README.md
!/ROADMAP.md
!/SUPPORT.md
!/TRADEMARKS.md
!/NOTICE
!/manifest.json
!/media/
!/media/**
!/docs/
!/docs/**
!/icons/
!/icons/**
!/scripts/
!/scripts/**
!/src/
!/src/**
!/store/
!/store/**
!/LICENSE*
!/SECURITY.md
!/.imgbotconfig
!/package.json

/media/**/node_modules/
/media/**/.remotion/
/media/**/.cache/
/media/**/coverage/
/media/**/frames/
/media/**/renders/
/media/**/public/generated/
/media/**/public/captures/
/media/**/output/
/media/**/*.log
/media/**/.env
/media/**/.env.*
