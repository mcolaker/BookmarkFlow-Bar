!/scripts/validate-assets.mjs
!/scripts/validate-dco.mjs
!/scripts/validate-open-source.mjs
!/scripts/validate-project.mjs
!/scripts/verify-public-tree.mjs
!/src/
!/src/**
!/store/
!/store/**
!/tools/
/tools/*
!/tools/windows-companion/
/tools/windows-companion/*
!/tools/windows-companion/BookmarkFlowCompanion.ps1
!/tools/windows-companion/README.md
!/tools/windows-companion/host-manifest-template.json
