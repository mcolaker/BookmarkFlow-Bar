# Public repository allowlist. Generated browser profiles and release archives
# stay outside Git even when new files are added to those directories.
/*

!/.gitignore
!/.gitattributes
!/.github/
!/.github/**
!/AGENTS.md
!/_locales/
!/_locales/**
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/README.md
!/manifest.json
!/docs/
!/docs/**
!/icons/
!/icons/**
!/scripts/
!/scripts/**
!/src/
!/src/**
!/store/
!/store/**
!/LICENSE*
!/SECURITY.md
