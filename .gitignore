!/SUPPORT.md
!/TRADEMARKS.md
!/NOTICE
!/manifest.json
!/media/
!/media/**
!/docs/
/docs/*
!/docs/ASSET_PROVENANCE.md
!/docs/index.html
!/docs/assets/
!/docs/assets/**
!/docs/privacy/
!/docs/privacy/**
!/icons/
!/icons/**
