{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.1.39",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "homepage_url": "https://mcolaker.github.io/BookmarkFlow-Bar/",
  "permissions": [
    "bookmarks",
    "storage",
    "favicon",
    "search"
  ],
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "Alt+Shift+K"
      },
      "description": "__MSG_commandOpenSearch__"
    },
    "toggle-bar": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "__MSG_commandToggleBar__"
    },
    "hide-restore": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "__MSG_commandHideRestore__"
    },
    "toggle-streamer-mode": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "__MSG_commandStreamerMode__"
    }
  },
  "chrome_url_overrides": {
    "newtab": "src/newtab.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/i18n.js",
        "src/settings.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*",
        "src/content.css",
        "src/newtab.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
